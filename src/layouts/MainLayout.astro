---
import "../styles/global.css";
import Head from "./MainHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ContactStrip from "../components/pages/contacts/ContactStrip.astro";
import ScrollToTopButton from "../components/ui/ScrollToTopButton.astro";

import { getSiteContacts } from "../config/site/contacts";

import type { PageKey } from "../config/pages/pageDefinitions";
import type { Language } from "../config/i18n/i18n";
import type { PageSeo } from "../config/pages/pageTypes";

const { language, pageKey, seo, alternates } = Astro.props as {
  language: Language;
  pageKey: PageKey;
  seo?: Partial<PageSeo>;
  alternates?: Partial<Record<Language, string>>;
};

const contact = getSiteContacts(language);
---

<html lang={language}>
  <Head language={language} pageKey={pageKey} seo={seo} />

  <body class="font-inter">
    <ContactStrip
      email={contact.email}
      phone={contact.phone}
      phoneHref={contact.phoneHref}
      hours={contact.hours}
    />

    <Header language={language} pageKey={pageKey} alternates={alternates} />

    <slot />

    <Footer language={language} pageKey={pageKey} alternates={alternates} />

    <ScrollToTopButton />
  </body>
</html>