---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

import MainLayout from "../../../layouts/MainLayout.astro";
import PageHero from "../../../components/shared/PageHero.astro";

import { getSupplierPath } from "../../../lib/suppliers/supplierPaths";

import type { Language } from "../../../config/i18n/i18n";

type SupplierEntry = CollectionEntry<"suppliers">;

export async function getStaticPaths() {
  const suppliers = await getCollection("suppliers", ({ data }) => {
    return data.language === "en";
  });

  return suppliers.map((supplier) => ({
    params: {
      slug: supplier.data.slug,
    },
    props: {
      supplier,
    },
  }));
}

const { supplier } = Astro.props as {
  supplier: SupplierEntry;
};

const { Content } = await render(supplier);

const translatedSuppliers = await getCollection(
  "suppliers",
  ({ data }) => {
    return data.translationKey === supplier.data.translationKey;
  },
);

const bgSupplier = translatedSuppliers.find(
  ({ data }) => data.language === "bg",
);

const enSupplier = translatedSuppliers.find(
  ({ data }) => data.language === "en",
);

const canonicalPath = getSupplierPath(supplier);

const alternates: Partial<Record<Language, string>> = {
  ...(bgSupplier && {
    bg: getSupplierPath(bgSupplier),
  }),
  ...(enSupplier && {
    en: getSupplierPath(enSupplier),
  }),
};

const pageTitle =
  supplier.data.seoTitle ?? `${supplier.data.name} | Pools4You`;

const pageDescription =
  supplier.data.seoDescription ?? supplier.data.summary;
---

<MainLayout
  language="en"
  pageKey="about"
  seo={{
    title: pageTitle,
    description: pageDescription,
    canonical: canonicalPath,
    alternates,
  }}
  alternates={alternates}
>
  <PageHero title={supplier.data.name} />

  <section class="supplier-detail section">
    <div class="site-container">
      <div class="supplier-detail__content">
        <Content />
      </div>

      {
        supplier.data.website && (
          <a
            class="supplier-detail__website"
            href={supplier.data.website}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit website
          </a>
        )
      }
    </div>
  </section>
</MainLayout>