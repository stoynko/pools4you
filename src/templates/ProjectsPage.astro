---
import { getCollection } from "astro:content";

import Layout from "../layouts/MainLayout.astro";

import ProjectsHero from "../components/pages/projects/ProjectsHero.astro";
import ProjectsList from "../components/pages/projects/ProjectsList.astro";

import { getPageTranslations } from "../lib/i18n";
import { getPagePath } from "../config/pages/pagePaths";

import type { PageKey } from "../config/pages/pageDefinitions";
import type { Language } from "../config/i18n/i18n";

type Props = {
  language: Language;
  pageKey: PageKey;
};

const { language, pageKey } = Astro.props as Props;

const translation = getPageTranslations(language, "projects");

const projects = await getCollection("projects", ({ data }) => {
  return data.language === language;
});

const sortedProjects = projects.sort((a, b) => {
  return b.data.date.getTime() - a.data.date.getTime();
});

const canonical = getPagePath("projects", language);

const pageSeo = {
  title: translation.hero.title,
  description: translation.hero.subtitle,
  canonical,
  alternates: {
    bg: getPagePath("projects", "bg"),
    en: getPagePath("projects", "en"),
  },
};
---

<Layout language={language} pageKey={pageKey} seo={pageSeo}>
  <main class="projects-page">
    <ProjectsHero translation={translation.hero} />

    <ProjectsList language={language} projects={sortedProjects} translation={{
        title: translation.list?.title ?? translation.hero.title,
        empty: translation.empty,
      }}
    />
  </main>
</Layout>
