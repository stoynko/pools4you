---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

import MainLayout from "../../layouts/MainLayout.astro";
import ProjectHero from "../../components/pages/projects/ProjectsHero.astro";
import ProjectGallery from "../../components/pages/projects/ProjectGallery.astro";

import { createProjectStructuredData } from "../../lib/seo/projectData";
import {
  getSiteBaseUrl,
  toAbsoluteUrl,
} from "../../lib/seo/urlBase";

import type { Language } from "../../config/i18n/i18n";

type ProjectEntry = CollectionEntry<"projects">;

type Props = {
  project: ProjectEntry;
  language: Language;
};

const { project, language } = Astro.props as Props;

const {
  title,
  description,
  date,
  location,
  area,
  heroImage,
  heroImagePosition,
  gallery,
  seoTitle,
  seoDescription,
  slug,
  translationKey,
} = project.data;

const projectPath =
  language === "bg"
    ? `/proekti/${slug}`
    : `/en/projects/${slug}`;

const baseUrl = getSiteBaseUrl(Astro.site);

const projectUrl = toAbsoluteUrl(
  projectPath,
  baseUrl,
);

const heroImageUrl = toAbsoluteUrl(
  heroImage.src,
  baseUrl,
);

const translatedProjects = await getCollection(
  "projects",
  ({ data }) => {
    return data.translationKey === translationKey;
  },
);

const bgProject = translatedProjects.find(
  ({ data }) => {
    return data.language === "bg";
  },
);

const enProject = translatedProjects.find(
  ({ data }) => {
    return data.language === "en";
  },
);

const alternates = {
  bg: bgProject
    ? `/proekti/${bgProject.data.slug}`
    : undefined,

  en: enProject
    ? `/en/projects/${enProject.data.slug}`
    : undefined,
};

const structuredData = createProjectStructuredData({
  project,
  projectUrl,
  heroImageUrl,
  baseUrl,
});

const pageSeo = {
  title: seoTitle ?? `${title} | Pools4You`,
  description: seoDescription ?? description,
  canonical: projectPath,
  alternates,

  ogTitle: seoTitle ?? title,
  ogDescription: seoDescription ?? description,
  ogType: "article" as const,

  ogImage: {
    src: heroImage.src,
    alt: title,
    width: heroImage.width,
    height: heroImage.height,
  },

  structuredData,
};

const { Content } = await render(project);
---

<MainLayout
  language={language}
  pageKey="projects"
  alternates={alternates}
  seo={pageSeo}
>
  <main class="project-detail-page">
    <ProjectHero
      language={language}
      title={title}
      location={location}
      area={area}
      date={date}
      heroImage={heroImage}
      heroImagePosition={heroImagePosition}
/>

    {
      gallery.length > 0 && (
        <section class="project-detail-gallery-section">
          <div class="site-container-wide">
            <ProjectGallery images={gallery} />
          </div>
        </section>
      )
    }

    <section class="project-detail-content">
      <div class="site-container-wide">
        <article class="project-detail-content__body u-no-select">
          <Content />
        </article>
      </div>
    </section>
  </main>
</MainLayout>