---
import { getCollection, type CollectionEntry } from "astro:content";

import Layout from "../layouts/MainLayout.astro";
import PageHero from "../components/shared/PageHero.astro";

import AboutThinkingSection from "../components/pages/about/AboutThinkingSection.astro";
import AboutPrinciplesSection from "../components/pages/about/AboutPrinciplesSection.astro";
import AboutSuppliersSection from "../components/pages/about/AboutSuppliersSection.astro";

import { getPageTranslations } from "../lib/i18n";

import type { PageKey } from "../config/pages/pageDefinitions";
import type { Language } from "../config/i18n/i18n";

type SupplierEntry = CollectionEntry<"suppliers">;

type Props = {
  language: Language;
  pageKey: PageKey;
};

const { language, pageKey } = Astro.props as Props;

const translation = getPageTranslations(language, "about");

const suppliers = await getCollection("suppliers", ({ data }) => {
  return data.language === language && data.featured;
});

const sortedSuppliers: SupplierEntry[] = suppliers.sort((a, b) => {
  return a.data.order - b.data.order;
});
---

<Layout language={language} pageKey={pageKey}>
  <PageHero
    title={translation.title}
    body={translation.description}
    align="left"
    divider="short"
  />

  <!-- <AboutThinkingSection
    eyebrow={translation.thinking.eyebrow}
    title={translation.thinking.title}
    description={translation.thinking.description}
    imageAlt={translation.thinking.imageAlt}
    paragraphs={translation.thinking.paragraphs}
  />

  <AboutPrinciplesSection
    eyebrow={translation.principles.eyebrow}
    title={translation.principles.title}
    description={translation.principles.description}
    items={translation.principles.items}
  /> -->

  <AboutSuppliersSection
    title={translation.suppliers.title}
    suppliers={sortedSuppliers}
  />
</Layout>
