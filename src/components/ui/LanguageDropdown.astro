---
import type { PageKey } from "../../config/pages/pageDefinitions.ts";
import type { Language } from "../../config/i18n/i18n.ts";

import { getPagePath } from "../../config/pages/pagePaths.ts";

import Icon from "./icons/Icon.astro";

const { language, pageKey, alternates } = Astro.props as {
  language: Language;
  pageKey: PageKey;
  alternates?: Partial<Record<Language, string>>;
};

const bgPath = alternates?.bg ?? getPagePath(pageKey, "bg");
const enPath = alternates?.en ?? getPagePath(pageKey, "en");
---

<div
  class="language-dropdown"
  data-language-dropdown
>
  <button
    type="button"
    class="language-dropdown__button"
    aria-label={language === "bg"
      ? "Отвори меню за избор на език"
      : "Open language menu"}
    aria-haspopup="true"
    aria-expanded="false"
    data-language-dropdown-button
  >
    <Icon
      name="globe"
      class="language-dropdown__globe"
    />

    <Icon
      name="chevronDown"
      class="language-dropdown__chevron"
    />
  </button>

  <div
    class="language-dropdown__menu hidden"
    data-language-dropdown-menu
  >
    <a
      href={bgPath}
      aria-current={language === "bg" ? "page" : undefined}
      class:list={[
        "language-dropdown__option",
        {
          "language-dropdown__option--active":
            language === "bg",
        },
      ]}
    >
      BG
    </a>

    <a
      href={enPath}
      aria-current={language === "en" ? "page" : undefined}
      class:list={[
        "language-dropdown__option",
        {
          "language-dropdown__option--active":
            language === "en",
        },
      ]}
    >
      EN
    </a>
  </div>
</div>

<script>
  import { initLanguageDropdowns } from "../../scripts/components/languageDropdown";

  initLanguageDropdowns();

  document.addEventListener(
    "astro:page-load",
    initLanguageDropdowns,
  );
</script>