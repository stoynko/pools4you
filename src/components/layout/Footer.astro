---
import { getCollection } from "astro:content";

import type { Language } from "../../config/i18n/i18n";
import { getPagePath } from "../../config/pages/pagePaths";
import { footerSections } from "../../config/site/footer";

import { getFacilityPath } from "../../lib/facilities/facilityPaths";
import { getPageTranslations } from "../../lib/i18n";

import FooterLogo from "../brand/FooterLogo.astro";
import FooterColumn from "./footer/FooterColumn.astro";
import FooterLegal from "./footer/FooterLegal.astro";
import FooterSocials from "./footer/FooterSocials.astro";

const { language } = Astro.props as {
  language: Language;
};

const translation = getPageTranslations(language, "footer");

const facilities = await getCollection(
  "facilities",
  ({ data }) => data.language === language
);

const facilityLinks = facilities
  .sort((a, b) => a.data.order - b.data.order)
  .map((facility) => ({
    label: facility.data.title,
    href: getFacilityPath(facility)
  }));

const sections = footerSections.map((section) => {
  const title = translation[section.titleKey];

  if (section.source === "facilities") {
    return { key: section.key, title, links: facilityLinks};
  }

  return { key: section.key, title, links: section.links.map((link) => ({
      label: translation[link.labelKey],
      href: getPagePath(
        link.page,
        language)
    }))
  };
});
---

<footer class="site-footer relative mt-24 overflow-visible bg-site text-text-secondary 
               min-[641px]:mt-28 min-[1025px]:mt-32u-no-select" 
               data-footer-reveal>

  <div class="footer-brand-shell footer-brand-shell--animated site-container-wide pointer-events-none absolute
              left-1/2 top-0 z-[5] -translate-x-1/2 -translate-y-[45%] min-[641px]:-translate-y-1/2" 
              data-footer-divider-reveal>

    <div class="footer-brand-row relative block h-[var(--footer-logo-height)] w-full">
      <FooterLogo />
      <div class="footer-brand-divider footer-brand-divider--left" aria-hidden="true"/>
      <div class="footer-brand-divider footer-brand-divider--right" aria-hidden="true"/>
    </div>
  </div>

  <div class="footer-content-viewport">
    <div class="footer-inner site-container-narrow pb-6 pt-28 min-[641px]:pb-8 min-[641px]:pt-[7.5rem] min-[1025px]:pt-32">
      <div class="footer-columns grid w-full grid-cols-2 items-start justify-items-start gap-x-4 gap-y-10
              min-[641px]:justify-items-center min-[641px]:gap-x-20 min-[641px]:gap-y-12
              min-[1025px]:grid-cols-[repeat(auto-fit,minmax(11rem,1fr))] min-[1025px]:gap-[clamp(3rem,6vw,7rem)]">
        {
          sections.map((section) => (
            <FooterColumn title={section.title} links={section.links}/>
          ))
        }
      </div>

      <FooterSocials language={language} />
      <FooterLegal language={language} />

    </div>
  </div>
</footer>