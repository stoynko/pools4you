---
import type { Language } from "../../../config/i18n/i18n";
import { getPagePath } from "../../../config/pages/pagePaths";

import { getPageTranslations } from "../../../lib/i18n";

const { language } = Astro.props as {
  language: Language;
};

const translation = getPageTranslations(language, "footer");
const fallbackPath = getPagePath("home", language);
const currentYear = new Date().getFullYear();
---

<div class="footer-legal mt-2 flexflex-col items-center gap-[0.3rem] pt-2
    text-center font-inter text-sm font-normal leading-6 text-text-secondary
    will-change-[transform,opacity]">
    
  <p class="m-0">
    &copy; {currentYear} Pools 4 You LTD. {translation.rightsReserved}
  </p>

  <div class="flex items-center justify-center gap-2 max-[640px]:flex-wrap">
    <a href={fallbackPath} data-label={translation.terms} 
       class="footer-link-effect relative inline-flex items-center whitespace-nowrap
        text-text-secondary transition-colors duration-[180ms] hover:text-text
        focus-visible:text-text motion-reduce:transition-none">
      {translation.terms}
    </a>

    <span class="opacity-75" aria-hidden="true">
      &VerticalSeparator;
    </span>

    <a href={fallbackPath} data-label={translation.privacy}
       class=" footer-link-effect relative inline-flex items-center whitespace-nowrap
        text-text-secondary transition-colors duration-[180ms]hover:text-text
        focus-visible:text-text motion-reduce:transition-none">
      {translation.privacy}
    </a>
  </div>
</div>