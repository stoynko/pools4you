---
import type { IconName } from "../../ui/icons/iconPaths";

import Icon from "../../ui/icons/Icon.astro";
import CtaButton from "../../shared/CtaButton.astro";

type Props = {
  icon: IconName;
  title: string;
  text: string;
  button: string;
  href: string;
};

const { icon, title, text, button, href } = Astro.props as Props;
---

<article class="contact-method-card u-no-select">
  <div class="contact-method-card__icon u-no-select" aria-hidden="true">
    <Icon name={icon} />
  </div>

  <h2 class="contact-method-card__title u-no-select">
    {title}
  </h2>

  <p class="contact-method-card__text u-no-select">
    {text}
  </p>

  <CtaButton href={href} label={button} size="md" class="mt-9 self-end max-sm:mt-7"/>
  
</article>