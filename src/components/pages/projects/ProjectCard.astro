---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Language } from "../../../config/i18n/i18n";

import Icon from "../../ui/icons/Icon.astro";

type ProjectEntry = CollectionEntry<"projects">;

type Props = {
  project: ProjectEntry;
  href: string;
  language: Language;
};

const { project, href, language } = Astro.props as Props;

const formattedDate = project.data.date.toLocaleDateString(
  language === "bg" ? "bg-BG" : "en-GB",
);
---

<article class="project-list-card u-no-select">
  <a href={href} class="project-list-card__link card-hover">
    <div class="project-list-card__media">
      <Image
        src={project.data.thumbnailImage}
        width={project.data.thumbnailImage.width}
        height={project.data.thumbnailImage.height}
        alt={project.data.title}
        loading="lazy"
        decoding="async"
        class="project-list-card__image"
      />

      <span class="project-list-card__action" aria-hidden="true">
        <Icon name="externalLink" />
      </span>
    </div>

    <div class="project-list-card__content">
      <div class="project-list-card__meta">
        <span>{project.data.location}</span>
        <span aria-hidden="true">•</span>

        <time datetime={project.data.date.toISOString()}>
          {formattedDate}
        </time>
      </div>

      <h2>{project.data.title}</h2>

      <p>{project.data.description}</p>
    </div>
  </a>
</article>