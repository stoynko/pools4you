---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import Icon from "../../ui/icons/Icon.astro";

type Props = {
  project: CollectionEntry<"projects">;
  href: string;
  ctaLabel: string;
  isReversed?: boolean;
  eager?: boolean;
};

const {
  project,
  href,
  ctaLabel,
  isReversed = false,
  eager = false,
} = Astro.props as Props;
---

<article
  class:list={[
    "featured-project",
    { "featured-project-reversed": isReversed },
  ]}
>
  <a
    href={href}
    class="project-list-card__link card-hover featured-project-image-link"
    aria-label={`${ctaLabel}: ${project.data.title}`}
  >
    <div class="project-list-card__media featured-project-image-media">
      <Image
        src={project.data.thumbnailImage}
        width={project.data.thumbnailImage.width}
        height={project.data.thumbnailImage.height}
        alt={project.data.title}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class="project-list-card__image featured-project-image"
      />

      <span class="featured-project-image-action" aria-hidden="true">
        <Icon name="externalLink" />
      </span>
    </div>
  </a>

  <div class="featured-project-content">
    <h3 class="featured-project-title">
      {project.data.title}
    </h3>

    {
      project.data.featuredQuote && (
        <p class="featured-project-quote">
          “{project.data.featuredQuote}”
        </p>
      )
    }

    <p class="featured-project-description">
      {project.data.featuredExcerpt ?? project.data.description}
    </p>

    <div class="featured-project-cta">
      <a href={href} class="button-primary w-fit">
        {ctaLabel}
      </a>
    </div>
  </div>
</article>