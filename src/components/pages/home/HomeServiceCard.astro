---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import Icon from "../../ui/icons/Icon.astro";

type Props = {
  id: string;
  title: string;
  href: string;
  image: ImageMetadata;
  alt: string;
};

const { id, title, href, image, alt } = Astro.props as Props;
---

<article id={id} data-service-id={id} class="home-service-card group">
  <a href={href} class="home-service-card__link flex flex-col items-center text-center">
    <div class="home-service-card__media">
      <Image
        src={image}
        alt={alt}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        class="home-service-card__image"
      />

      <div class="home-service-card__overlay" aria-hidden="true"></div>

      <span class="home-service-card__action" aria-hidden="true">
        <Icon name="externalLink" />
      </span>
    </div>

    <h3 class="service-card-title-effect mt-5 inline-block text-center font-inter text-lg font-bold leading-tight tracking-tight sm:text-xl">
      {title}
    </h3>
  </a>
</article>