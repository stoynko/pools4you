---
import { getCollection } from "astro:content";

import type { Language } from "../../../config/i18n/i18n";
import { getPageTranslations } from "../../../lib/i18n";
import SectionDivider from "../../shared/SectionDivider.astro";

type Props = {
  language: Language;
  dividerOverhang?: string;
};

const {
  language,
  dividerOverhang = "3rem",
} = Astro.props as Props;

const translation = getPageTranslations(language, "home");

const clients = (
  await getCollection("homeClients", ({ data }) => data.enabled)
).sort((a, b) => a.data.order - b.data.order);
---

{
  clients.length > 0 && (
    <section
      class="home-clients section-header-reveal u-no-select"
      aria-labelledby="home-clients-label"
      data-home-clients
    >
      <header class="home-clients__header">
        <h2
          id="home-clients-label"
          class="home-clients__label section-header-reveal__title"
        >
          {translation.clients.label}
        </h2>

        <div class="mt-4">
          <SectionDivider
            class="section-header-reveal__divider"
            overhang={dividerOverhang}
          />
        </div>
      </header>

      <div
        class="home-clients__viewport"
        data-home-clients-viewport
      >
        <div
          class="home-clients__track"
          role="list"
          data-home-clients-track
        >
          {
            clients.map((client) => {
              const ariaLabel =
                client.data.ariaLabel ?? client.data.name;

              return (
                <div
                  class="home-clients__item"
                  role="listitem"
                  data-home-client
                  data-client-id={client.id}
                >
                  {
                    client.data.website ? (
                      <a
                        class="home-clients__logo"
                        href={client.data.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={ariaLabel}
                        data-home-client-logo
                      >
                        <img
                          src={client.data.logo}
                          alt=""
                          loading="lazy"
                          draggable="false"
                        />
                      </a>
                    ) : (
                      <span
                        class="home-clients__logo"
                        role="img"
                        aria-label={ariaLabel}
                        data-home-client-logo
                      >
                        <img
                          src={client.data.logo}
                          alt=""
                          loading="lazy"
                          draggable="false"
                        />
                      </span>
                    )
                  }
                </div>
              );
            })
          }
        </div>
      </div>
    </section>
  )
}