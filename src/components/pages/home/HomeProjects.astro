---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import type { Language } from "../../../config/i18n/i18n";
import { getPagePath } from "../../../config/pages/pagePaths";
import { getPageTranslations } from "../../../lib/i18n";
import CtaButton from "../../shared/CtaButton.astro";
import HomeProjectCard from "./HomeProjectCard.astro";
import SectionDivider from "../../shared/SectionDivider.astro";

type Props = { language: Language; limit?: number; };
const { language, limit = 5 } = Astro.props as Props;
const translation = getPageTranslations(language, "home");
const sectionTitle = translation.featuredProjects.title;
const sectionDescription = translation.featuredProjects.intro;
const projectsHref = getPagePath("projects", language);
const allProjects = await getCollection("projects");

const featuredProjects = allProjects.filter((project) =>
  project.data.language === language && project.data.isFeatured).sort((a, b) => 
    b.data.date.getTime() - a.data.date.getTime()).slice(0, limit);

function getProjectHref(project: CollectionEntry<"projects">): string {
  const basePath =language === "en" ? "/en/projects" : "/proekti";

  return `${basePath}/${project.data.slug}`;
}

const projectsDividerOverhang = language === "bg" ? "3rem" : "2rem";
---

{
  featuredProjects.length > 0 && (
    <section class="home-projects section-header-reveal u-no-select" data-home-projects>
      <div class="site-container-wide">
        <header class="home-projects__header">
          
          <div class="mx-auto w-fit max-w-[90vw] text-center">

            <h2 class="home-projects__title section-header-reveal__title">
              {sectionTitle}
            </h2>

            <div class="mt-4">
              <SectionDivider class="home-projects__title-divider section-header-reveal__divider" 
              overhang={projectsDividerOverhang}
              />
            </div>
          </div>

          <p class="home-projects__description section-header-reveal__description">
            {sectionDescription}
          </p>
        </header>

        <div class="home-project-book" data-home-projects-book
          tabindex="0" aria-label={sectionTitle}>
          {
            featuredProjects.map((project, index) => (
                <HomeProjectCard
                  project={project}
                  href={getProjectHref(project)}
                  index={index}
                  isActive={ index === 0 }
                  viewProjectLabel={ translation.featuredProjects.projectCtaLabel }
                />
              )
            )
          }
        </div>


        {/* VIEW ALL PROJECTS CTA */}
        <div class="home-projects__footer">
          <CtaButton href={projectsHref} label={translation.featuredProjects.ctaLabel} size="lg"/>
        </div>

      </div>

      <script>
        import { initHomeProjects } from "../../../scripts/components/homeProjects";
        initHomeProjects();
        document.addEventListener("astro:page-load", initHomeProjects);
      </script>
    </section>
  )
}