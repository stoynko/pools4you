---
import type { Language } from "../../../config/i18n/i18n";
import { getPageTranslations } from "../../../lib/i18n";
import type { IconName } from "../../ui/icons/iconPaths";

import HomeVisionItem from "./HomeVisionItem.astro";

type Props = {
  language: Language;
};

const { language } = Astro.props as Props;

const translation = getPageTranslations(language, "home");
const vision = translation.vision;
---

<section class="home-vision section-shell u-no-select" data-home-vision>
  <div class="home-vision__accents-band">
    <div class="site-container-wide">
      <header class="home-vision__accents-header">
        <h3 class="home-vision__accents-title">
          {vision.accentsTitle}
        </h3>

        <p class="home-vision__accents-description">
          {vision.accentsDescription}
        </p>
      </header>

      <div class="home-vision__grid">
        {
          vision.accents.map((accent) => (
            <HomeVisionItem
              id={accent.id}
              icon={accent.icon as IconName}
              title={accent.title}
              body={accent.body}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
