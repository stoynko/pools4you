---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import type { Language } from "../../../config/i18n/i18n";
import { serviceHighlightImages } from "../../../lib/index/serviceHighlightsImages";
import Icon from "../../ui/icons/Icon.astro";

interface Props {
  language: Language;
}

const { language } = Astro.props as Props;

const services = (
  await getCollection(
    "serviceHighlights",
    ({ data }) => data.language === language
  )).sort(
  (a, b) => a.data.order - b.data.order);
---

<section class="service-highlights" data-service-highlights style={`--service-count: ${services.length}`}>
  <div class="service-highlights__sticky">
    <div class="service-highlights__media" aria-hidden="true">
      {
        services.map((service, index) => (
            <div class:list={["service-highlights__image", {
                  "is-active": index === 0,
                }]}
              data-service-image={index}>
              <Image src={ serviceHighlightImages[service.data.imageKey]} alt=""
                widths={[960, 1280, 1600, 1920]}
                sizes="100vw"
                loading={index === 0 ? "eager" : "lazy"}
                style={`object-position: ${service.data.imagePosition}`}
              />
            </div>
      ))}

      <div class="service-highlights__overlay"/>
    </div>

    <div class="service-highlights__content site-container-wide">
      <div class="service-highlights__copy">
        {
          services.map((service, index) => (
              <article class:list={["service-highlights__copy-layer", {
                    "is-active": index === 0,
                  }]}
                data-service-copy = {index}
                aria-hidden = {index === 0 ? "false" : "true"}
              >
                <h2 class="service-highlights__title">
                  { service.data.title }
                </h2>

                <div class="service-highlights__description-box">
                  <p class="service-highlights__description">
                    { service.data.description }
                  </p>
                </div>

                <div class="service-highlights__cta-row">
                  <a class="service-highlights__cta" href = { service.data.href }
                    tabindex={index === 0 ? 0 : -1 }
                  >
                    <span>
                      { service.data.buttonLabel }
                    </span>
                  </a>
                </div>
              </article>
       ))}
      </div>

      <div class="service-highlights__controls" aria-hidden="true">
        <div class="service-highlights__scroll-hint" data-service-scroll-hint>
          <Icon name="chevronDown" class="scroll-cue-chevron"/>
        </div>
      </div>
    </div>
  </div>
</section>