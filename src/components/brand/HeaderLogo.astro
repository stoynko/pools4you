---
import type { Language } from "../../config/i18n/i18n";
import { getPagePath } from "../../config/pages/pagePaths";

const { language, variant = "color" } = Astro.props as {
  language: Language;
  variant?: "color" | "black";
};

const homePath = getPagePath("home", language);

const logoImageClass = "block h-logo w-auto max-w-none";

const logoSrc =
  variant === "black"
    ? "/images/brand/pools4you-logo-text-black.svg"
    : "/images/brand/pools4you-logo-text-color.svg";
---

<a
  href={homePath}
  class="inline-flex shrink-0 items-center"
  aria-label="Pools4You home"
>
  <img
    src={logoSrc}
    alt="Pools4You Ltd."
    class={logoImageClass}
    loading="eager"
    decoding="async"
  />
</a>