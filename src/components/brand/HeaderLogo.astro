---
import type { Language } from "../../config/i18n/i18n";
import { getPagePath } from "../../config/pages/pagePaths";

const { language } = Astro.props as {
  language: Language;
};

const homePath = getPagePath("home", language);
---

<a
  href={homePath}
  class="header-logo-link inline-flex shrink-0 items-center"
  aria-label="Pools4You home"
>
  <img
    src="/images/brand/pools4you-logo-text.svg"
    alt="Pools4You Ltd."
    class="header-logo-image block h-logo w-auto max-w-none"
    loading="eager"
    decoding="async"
    draggable="false"
  />
</a>

<style>
  .header-logo-link,
  .header-logo-link *,
  .header-logo-image {
    cursor: pointer !important;
  }

  .header-logo-image {
    user-select: none;
    pointer-events: none;
    -webkit-user-drag: none;
  }
</style>