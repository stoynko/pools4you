---
type Props = {
  title: string;
  description?: string;
  size?: "default" | "large";
  descriptionSize?: "default" | "large";
  descriptionWeight?: "normal" | "semibold";
};

const {
  title,
  description,
  size = "default",
  descriptionSize = "default",
  descriptionWeight = "normal",
} = Astro.props as Props;

const isLarge = size === "large";
const isDescriptionLarge = descriptionSize === "large";
---

<div class="mb-14 sm:mb-18 lg:mb-20 2xl:mb-24">
  <h2
    class:list={[
      "font-libertinus font-semibold leading-tight text-brand-gold",
      isLarge
        ? "text-4xl sm:text-5xl"
        : "text-3xl sm:text-4xl",
    ]}
  >
    {title}
  </h2>

  <div class="mt-5 h-px w-full bg-brand-gold"></div>

  {
    description && (
      <p
        class:list={[
          "ml-auto mt-4 font-inter text-right leading-relaxed text-text-secondary",
          descriptionWeight === "semibold"
            ? "font-semibold"
            : "font-normal",
          isDescriptionLarge
            ? "w-full max-w-none text-lg sm:text-xl"
            : "max-w-[52rem] text-sm sm:text-[0.95rem]",
        ]}
      >
        {description}
      </p>
    )
  }
</div>