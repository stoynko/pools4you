---
type Props = {
  title: string;
  description?: string;
  size?: "default" | "large";
  introSize?: "default" | "large";
  introAlign?: "left" | "right";
  buttonLabel?: string;
  buttonHref?: string;
  buttonVariant?: "primary" | "ghost";
};

const {
  title,
  description,
  size = "default",
  introSize = "default",
  introAlign = "right",
  buttonLabel,
  buttonHref,
  buttonVariant = "primary",
} = Astro.props as Props;

const isLarge = size === "large";
const isIntroLarge = introSize === "large";
const isIntroRight = introAlign === "right";
const hasButton = Boolean(buttonLabel && buttonHref);

const buttonClass =
  buttonVariant === "ghost" ? "button-ghost w-fit" : "button-primary w-fit";
---

<div class="section-header">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2
        class:list={[
          "font-libertinus font-semibold leading-tight text-brand-gold",
          isLarge
            ? "text-4xl sm:text-5xl"
            : "text-3xl sm:text-4xl",
        ]}
      >
        {title}
      </h2>
    </div>

    {
      hasButton ? (
        <a href={buttonHref} class={buttonClass}>
          {buttonLabel}
        </a>
      ) : (
        <slot name="action" />
      )
    }
  </div>

  <div class="mt-5 h-px w-full bg-brand-gold"></div>

  {
    description && (
      <p
        class:list={[
          "mt-4 max-w-[52rem] font-inter font-semibold leading-relaxed text-text-muted",
          isIntroLarge
            ? "text-base sm:text-[1.05rem] lg:text-[1.125rem]"
            : "text-sm sm:text-[0.95rem]",
          isIntroRight && "ml-auto text-right",
        ]}
      >
        {description}
      </p>
    )
  }
</div>